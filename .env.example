POSTGRES_USER=mushroom
POSTGRES_PASSWORD=mushroom
POSTGRES_DB=mushroom
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# Host directory that receives the database dumps. On the droplet the deploy
# workflow sets this to a path outside the repository checkout.
BACKUP_DIR=./backups
# First administrator for a local stack: created at startup when no user
# exists. Choose your own values; the password needs at least 10 characters.
# On the droplet these come from GitHub Actions secrets, never from this file.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

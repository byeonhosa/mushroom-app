{
  "name": "mushroom-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "generate:api-contract": "node ./scripts/generate-api-contract.mjs",
    "check:api-contract": "npm run generate:api-contract && git diff --exit-code -- lib/generated/openapi.json lib/generated/api-schema.ts",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build",
    "start": "cp -r .next/static .next/standalone/.next/ && PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/server.js"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3"
  }
}
